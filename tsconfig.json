{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "outDir": "./public/js",
    "rootDir": "./public/ts",
    "sourceMap": false
  },
  "include": [
    "public/ts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
